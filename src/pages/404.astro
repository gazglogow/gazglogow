---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base noindex title="Nie znaleziono strony — Usługi gazowe Głogów" description="Wróć do oferty usług gazowych w Głogowie i okolicach lub zadzwoń: 530 366 668.">
  <section class="section error-page shell"><p class="eyebrow">Błąd 404</p><h1>Nie ma takiej strony.</h1><p>Wróć do oferty lub skontaktuj się z nami telefonicznie.</p><div class="hero-actions"><a class="button button-primary" href="/">Przejdź do strony głównej</a><a class="text-link" href={site.phoneHref}>{site.phone}</a></div></section>
</Base>
