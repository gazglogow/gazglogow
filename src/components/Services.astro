---
import { withBase } from '../data/urls';
import { services } from '../data/services';
import Icon from './Icon.astro';
---
<section class="section services-section" id="uslugi" aria-labelledby="services-title">
  <div class="shell">
    <div class="services-heading"><p class="eyebrow">Zakres usług<span class="tiny-line"></span></p><h2 id="services-title">Instalacje gazowe</h2><p class="services-area">Głogów i okolice</p><p class="services-intro">Przeglądy instalacji, podłączanie urządzeń,<br class="services-break" /> próby szczelności i opinie techniczne.</p></div>
    <div class="service-list">
      {services.map(service => <a class="service-row" href={withBase(`/uslugi/${service.slug}/`)}><span class="service-number">{service.number}</span><h3>{service.title}</h3><p>{service.short}</p><span class="circle-arrow"><Icon name="arrow" /></span></a>)}
    </div>
  </div>
</section>
