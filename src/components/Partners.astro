---
import { withBase } from '../data/urls';
---
<section class="cooperation" aria-labelledby="partners-title"><div class="wrap"><header><div><div class="eyebrow">Współpraca</div><h2 id="partners-title">Współpracujemy lokalnie.</h2></div><p>Obsługujemy zarządców nieruchomości,<br>firmy i instytucje w Głogowie i okolicach.</p></header>
<section class="group"><h3>Zarządcy nieruchomości</h3><div class="grid">
<a class="partner" href="https://wenerski.glogow.pl/" target="_blank" rel="noopener noreferrer"><div class="logobox"><img class="wenerski" src={withBase('/images/partners/wenerski.png')} width="1062" height="200" loading="lazy" alt="Wenerski — Biuro Obsługi Nieruchomości"></div><h4>Biuro Obsługi Nieruchomości Wenerski</h4><p>Głogów · zarządzanie i obsługa nieruchomości</p><span class="visit">WENERSKI.GLOGOW.PL <span class="sr-only"> — otwiera nową kartę</span><b aria-hidden="true">↗</b></span></a>
<a class="partner" href="http://domator.glogow.pl/" target="_blank" rel="noopener noreferrer"><div class="logobox"><img class="domator" src={withBase('/images/partners/domator.jpg')} width="372" height="74" loading="lazy" alt="Domator — logo z kluczami"></div><h4>Domator — Zarządzanie Nieruchomościami</h4><p>Głogów · obsługa nieruchomości i wspólnot</p><span class="visit">DOMATOR.GLOGOW.PL <span class="sr-only"> — otwiera nową kartę</span><b aria-hidden="true">↗</b></span></a>
</div></section><div class="bottom"><section class="group"><h3>Firmy</h3><a class="partner" href="https://aio.com.pl/" target="_blank" rel="noopener noreferrer"><div class="logobox"><img class="aio" src={withBase('/images/partners/alfa-i-omega.png')} width="760" height="320" loading="lazy" alt="Alfa i Omega — oryginalne logo"></div><h4>Alfa i Omega Sp. z o.o.</h4><p>Głogów · branża BHP</p><span class="visit">AIO.COM.PL <span class="sr-only"> — otwiera nową kartę</span><b aria-hidden="true">↗</b></span></a></section>
<section class="group"><h3>Instytucje</h3><a class="partner" href="https://gminaglogow.pl/" target="_blank" rel="noopener noreferrer"><div class="logobox municipality"><span aria-hidden="true">G</span><span>Gmina Głogów</span></div><h4>Realizacja zleceń dla Gminy Głogów</h4><p>Usługi dotyczące instalacji gazowych</p><span class="visit">GMINAGLOGOW.PL <span class="sr-only"> — otwiera nową kartę</span><b aria-hidden="true">↗</b></span></a></section></div></div></section>
<style>
*{box-sizing:border-box}.cooperation{margin:0;background:#121416;color:#f5f4f0;font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}a:focus-visible{outline:2px solid #f5cf74;outline-offset:6px}.wrap{max-width:1192px;margin:auto;padding:58px 48px 0}.eyebrow{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:#c3c5c5;display:flex;gap:15px;align-items:center}.eyebrow:before{content:'';width:32px;height:2px;background:#ec3341}header{display:flex;justify-content:space-between;align-items:end;gap:30px;padding-bottom:35px;border-bottom:1px solid #3b3e40}h2{font-family:Georgia,'Times New Roman',serif;font-size:49px;font-weight:400;letter-spacing:-.035em;line-height:1.12;margin:17px 0 0}header p{max-width:295px;font-size:14px;line-height:1.75;color:#b7bcbe;margin:0 0 4px}.group{padding-top:28px}h3{font-size:11px;font-weight:500;letter-spacing:.19em;text-transform:uppercase;color:#c3c7c8;margin:0 0 17px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.partner{display:flex;flex-direction:column;background:#1b1e21;border:1px solid #3b3e40;padding:24px 27px 20px;min-width:0;transition:border-color .2s,background .2s}.partner:hover{background:#23272a;border-color:#85898b}.logobox{height:75px;display:flex;align-items:center;margin-bottom:20px}.wenerski{width:100%;max-width:340px;height:auto}.domator{width:290px;max-width:100%;height:auto}.aio{width:122px;height:62px;object-fit:contain;background:#eee8dc;padding:5px 8px;border-radius:2px}.partner h4{font-size:18px;font-weight:500;line-height:1.4;letter-spacing:.005em;margin:0 0 6px}.partner p{color:#b7bdc0;font-size:12px;line-height:1.6;margin:0}.visit{margin-top:22px;padding-top:14px;border-top:1px solid #3a3e41;font-size:11px;letter-spacing:.07em;display:flex;align-items:center;justify-content:space-between;color:#f5f4f0}.visit b{font-size:22px;line-height:1;font-weight:400;color:#ef535e}.bottom{display:grid;grid-template-columns:1fr 1fr;gap:22px}.bottom .partner{min-height:226px}.bottom .logobox{height:62px;margin-bottom:14px}.municipality{display:flex;align-items:center;gap:17px;font-family:Georgia,serif;font-size:29px}.municipality span:first-child{width:48px;height:48px;border-left:2px solid #df404b;display:flex;align-items:center;padding-left:12px;font-family:Arial,sans-serif;font-size:23px;letter-spacing:-.08em;font-weight:700}.bottom .visit{margin-top:auto}.bottom .partner p{margin-bottom:18px}.wrap{padding-bottom:44px}.cooperation header{background:transparent;position:static}.cooperation h2,.cooperation h3,.cooperation h4{overflow-wrap:normal}.partner h4{font-family:Arial,Helvetica,sans-serif}.cooperation .eyebrow{font-weight:500}.cooperation .eyebrow:before{flex-shrink:0}.partner:focus-visible{outline:2px solid #f5cf74;outline-offset:5px}@media(max-width:700px){.wrap{padding:34px 22px 38px}header{display:block}h2{font-size:39px}header p{margin-top:20px}.grid,.bottom{grid-template-columns:1fr}.partner{padding:22px}}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
