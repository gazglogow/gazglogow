---
import { withBase } from '../data/urls';
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<section class="cinematic-hero" aria-labelledby="hero-title">
  <div class="cinematic-art" aria-hidden="true"><picture>
    <source type="image/avif" srcset={`${withBase('/images/carbon-960.avif')} 960w, ${withBase('/images/carbon-1600.avif')} 1600w`} sizes="100vw" />
    <img src={withBase('/images/carbon-1600.webp')} srcset={`${withBase('/images/carbon-960.webp')} 960w, ${withBase('/images/carbon-1600.webp')} 1600w`} sizes="100vw" width="1672" height="941" alt="" fetchpriority="high" />
  </picture></div>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="shell cinematic-content">
    <p class="eyebrow"><span class="tiny-line"></span>{site.area}</p>
    <h1 id="hero-title">PRZEGLĄDY<br />I USŁUGI<br /><span>GAZOWE.</span></h1>
    <p class="cinematic-lead">Bezpieczeństwo zaczyna się<br />od sprawnej instalacji.</p>
    <p class="cinematic-description">Przeglądy · Podłączanie urządzeń<br />Próby szczelności · Opinie techniczne</p>
    <div class="hero-actions"><a class="button button-primary" href={site.phoneHref}><Icon name="phone" />Zadzwoń: {site.phone}</a><a class="text-link" href="#uslugi">Poznaj usługi <span class="circle-arrow"><Icon name="arrow" /></span></a></div>
  </div>
  <div class="shell cinematic-bottom"><span>DLA DOMU. WSPÓLNOTY. FIRMY.</span><span class="hero-disclosure">Ilustracja wygenerowana</span><a href="#uslugi" aria-label="Przejdź do usług"><span aria-hidden="true">↓</span></a></div>
</section>
<script>
  const hero = document.querySelector<HTMLElement>('.cinematic-hero');
  const art = document.querySelector<HTMLElement>('.cinematic-art');
  const allowed = matchMedia('(prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) and (min-width: 1001px)');
  if (hero && art) {
    hero.addEventListener('pointermove', (event) => {
      if (!allowed.matches) return;
      const box = hero.getBoundingClientRect();
      const x = ((event.clientX - box.left) / box.width - .5) * 12;
      const y = ((event.clientY - box.top) / box.height - .5) * 8;
      art.style.setProperty('--pan-x', `${x}px`);
      art.style.setProperty('--pan-y', `${y}px`);
    });
    const reset = () => { art.style.setProperty('--pan-x', '0px'); art.style.setProperty('--pan-y', '0px'); };
    hero.addEventListener('pointerleave', reset);
    allowed.addEventListener('change', reset);
  }
</script>
