---
import { withBase } from '../data/urls';
import '@fontsource-variable/manrope';

import '@fontsource-variable/inter';

import '../styles/global.css';
import '../styles/editorial.css';
import '../styles/blog.css';
import '../styles/faq.css';
import Header from '../components/Header.astro';
import Partners from '../components/Partners.astro';
import Motion from '../components/Motion.astro';
import { site } from '../data/site';
import { isIndexable, websiteSchema } from '../data/seo';
interface Props { title: string; description: string; noindex?: boolean; ogType?: string; image?: string; }
const { title, description, noindex = false, ogType = 'website', image } = Astro.props;
const live = isIndexable;
const canonical = new URL(Astro.url.pathname, Astro.site || site.url);
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('nav-ready');</script>
    <meta name="theme-color" content="#18191a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={live && !noindex ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Usługi gazowe · Głogów" />
    {image && <meta property="og:image" content={new URL(withBase(image), Astro.site || site.url)} />}
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <Header />
    <main id="main"><slot /></main>
    <Partners />
    <footer class="site-footer"><div class="shell footer-inner"><a class="footer-brand footer-logo" href={withBase('/')}><img src={withBase('/images/gaz-glogow-gg.svg')} width="48" height="42" alt="" />Gaz Głogów</a><p>Instalacje gazowe · Głogów i okolice</p><a href={site.phoneHref}>{site.phone}</a><span class="copyright">© {new Date().getFullYear()} gazglogow.pl</span></div></footer>
    <Motion />
  </body>
</html>

